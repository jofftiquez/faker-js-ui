{
  "name": "@faker-js-ui/extension",
  "version": "2.0.0",
  "description": "Faker.js UI — cross-browser extension (WXT + Vue 3 + TS)",
  "type": "module",
  "private": true,
  "author": "Joff Tiquez <jofftiquez@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --no-config-discovery",
    "audit:faker": "node scripts/audit-faker.mjs",
    "postinstall": "wxt prepare",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@fontsource/roboto": "^5.2.10",
    "@lucide/vue": "^1.17.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.9.9",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.35",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.0.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.1.10",
    "web-ext": "^10.3.0",
    "wxt": "^0.20.26"
  }
}
