{
  "name": "fakerjsui",
  "version": "1.0.0",
  "private": true,
  "description": "Faker.js UI application and website",
  "author": "Joff Tiquez <jofftiquez@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev:ext": "pnpm --filter @faker-js-ui/extension dev",
    "dev:ext:firefox": "pnpm --filter @faker-js-ui/extension dev:firefox",
    "build:ext": "pnpm --filter @faker-js-ui/extension build",
    "build:ext:firefox": "pnpm --filter @faker-js-ui/extension build:firefox",
    "zip:ext": "pnpm --filter @faker-js-ui/extension zip && pnpm --filter @faker-js-ui/extension zip:firefox",
    "test:ext": "pnpm --filter @faker-js-ui/extension test:unit && pnpm --filter @faker-js-ui/extension test:e2e",
    "test:ext:unit": "pnpm --filter @faker-js-ui/extension test:unit",
    "dev:website": "pnpm --filter @faker-js-ui/website dev",
    "build:website": "pnpm --filter @faker-js-ui/website build",
    "lint:website": "pnpm --filter @faker-js-ui/website lint",
    "_legacy_dev:app": "pnpm --filter @faker-js-ui/app dev:spa",
    "_legacy_dev:bex": "pnpm --filter @faker-js-ui/app dev:bex",
    "_legacy_build:app": "pnpm --filter @faker-js-ui/app build:spa",
    "_legacy_build:bex": "pnpm --filter @faker-js-ui/app build:bex",
    "_legacy_lint:app": "pnpm --filter @faker-js-ui/app lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jofftiquez/faker-js-ui.git"
  },
  "bugs": {
    "url": "https://github.com/jofftiquez/faker-js-ui/issues"
  },
  "homepage": "https://github.com/jofftiquez/faker-js-ui#readme",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@9.15.1"
}
